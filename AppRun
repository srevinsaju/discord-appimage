#!/usr/bin/env bash
set -euo pipefail

app_dir="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
discord_binaries=()

for binary_name in Discord DiscordPTB DiscordCanary; do
  binary_path="$app_dir/$binary_name"
  if [[ -x "$binary_path" ]]; then
    discord_binaries+=("$binary_path")
  fi
done

if (( ${#discord_binaries[@]} != 1 )); then
  echo "expected exactly one Discord executable in $app_dir" >&2
  exit 1
fi

export PATH="$app_dir:$app_dir/usr/sbin:$PATH"
export LD_LIBRARY_PATH="$app_dir/usr/lib:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="$app_dir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$app_dir/usr/share/glib-2.0/schemas:${GSETTINGS_SCHEMA_DIR:-}"

exec "${discord_binaries[0]}" "$@"
